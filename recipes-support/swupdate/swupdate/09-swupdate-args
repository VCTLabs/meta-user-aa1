CFGFILE="/etc/swupdate.cfg"
HW_ID=$(cat /etc/hwrevision)

rootfs=`swupdate -g`

if [ $rootfs == '/dev/mmcblk0p3' ];then
    selection="stable,copy2"
else
    selection="stable,copy1"
fi

SWUPDATE_WEBSERVER_ARGS="--document-root @@SWU_WWW_DOC_ROOT@@ --port @@SWU_WWW_HTTP_PORT@@"
SWUPDATE_ARGS="-H ${HW_ID} -e ${selection} -p 'reboot' -f ${CFGFILE}"
