software =
{
        version = "0.1.0";
        description = "@@DESCRIPTION@@";

        hardware-compatibility: ["@@SOM_FAMILY_ID@@"];

        stable : {
                copy1 : {
                        images: (
                                {
                                        filename = "@@SWUPDATE_IMAGES@@-@@MACHINE@@.ext4.gz";
                                        sha256 = "$swupdate_get_sha256(@@SWUPDATE_IMAGES@@-@@MACHINE@@.ext4.gz)";
                                        device = "/dev/mmcblk0p5";
                                        type = "raw";
                                        compressed = "zlib";
                                        installed-directly = true;
                                        encrypted = true;
                                }
                        );
                        scripts: (
                                {
                                        filename = "preinstall.sh";
                                        sha256 = "$swupdate_get_sha256(preinstall.sh)";
                                        type = "preinstall";
                                },
                                {
                                        filename = "postinstall.sh";
                                        sha256 = "$swupdate_get_sha256(postinstall.sh)";
                                        type = "postinstall";
                                }
                        );
                        bootenv: (
                            { name = "partition"; value = "5"; },
                        );

                };
                copy2 : {
                        images: (
                                {
                                        filename = "@@SWUPDATE_IMAGES@@-@@MACHINE@@.ext4.gz";
                                        sha256 = "$swupdate_get_sha256(@@SWUPDATE_IMAGES@@-@@MACHINE@@.ext4.gz)";
                                        device = "/dev/mmcblk0p6";
                                        type = "raw";
                                        compressed = "zlib";
                                        installed-directly = true;
                                        encrypted = true;
                                }
                        );
                        scripts: (
                                {
                                        filename = "preinstall.sh";
                                        sha256 = "$swupdate_get_sha256(preinstall.sh)";
                                        type = "preinstall";
                                },
                                {
                                        filename = "postinstall.sh";
                                        sha256 = "$swupdate_get_sha256(postinstall.sh)";
                                        type = "postinstall";
                                }
                        );
                        bootenv: (
                            { name = "partition"; value = "6"; },
                        );
                };
        };
}
